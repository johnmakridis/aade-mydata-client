{
  "name": "aade-mydata-client",
  "version": "2.0.1",
  "description": "Node.js Client for AADE myDATA (my Digital Accounting and Tax Application) REST API v2.0.1",
  "main": "lib/index.js",
  "types": "lib/models/index.d.ts",
  "scripts": {
    "build": "tsc",
    "lint": "tslint -p tsconfig.json",
    "prebuild": "shx rm -rf lib",
    "postbuild": "shx cp -r src/xsd lib",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint",
    "preversion": "npm run lint",
    "version": "git add -A src",
    "postversion": "git push && git push --tags"
  },
  "author": "John Makridis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmakridis/aade-mydata-client.git"
  },
  "bugs": {
    "url": "https://github.com/johnmakridis/aade-mydata-client/issues"
  },
  "homepage": "https://github.com/johnmakridis/aade-mydata-client#readme",
  "keywords": [
    "AADE",
    "myData",
    "Greece",
    "REST",
    "API",
    "delivery-note",
    "invoicing"
  ],
  "dependencies": {
    "axios": "^0.21.1",
    "jsonix": "^3.0.0",
    "moment-timezone": "^0.5.33",
    "uuid": "^8.3.2",
    "xml-js": "^1.6.11",
    "xml2js": "^0.4.23"
  },
  "devDependencies": {
    "@types/node": "^14.14.27",
    "@types/uuid": "^8.3.0",
    "@types/xml2js": "^0.4.8",
    "shx": "^0.3.3",
    "tslint": "^6.1.3",
    "typescript": "^4.3.2",
    "xsd2ts": "^0.9.17"
  },
  "files": [
    "lib/**/*",
    "docs/CHANGELOG.md",
    "docs/EXAMPLES.md"
  ]
}
